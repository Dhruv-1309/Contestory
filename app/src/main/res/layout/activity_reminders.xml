<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:visibility="gone"
    tools:visibility="visible">

    <!--
        alarmInfoText is constrained to the top with a rounded alert banner style.
        The RecyclerView is constrained BELOW it so the banner never overlaps the list.
    -->
    <TextView
        android:id="@+id/alarmInfoText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_banner_stale"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:text="⏰ Alarms ring 5 minutes before each enabled contest. Tap its bell to turn it off."
        android:textColor="@color/banner_stale_text"
        android:textSize="12.5sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/remindersRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="84dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/alarmInfoText" />

    <LinearLayout
        android:id="@+id/remindersEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.35"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_reminders"
            app:tint="@color/accent_purple" />

        <TextView
            android:id="@+id/remindersEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reminders_empty_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/remindersEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:paddingHorizontal="40dp"
            android:text="@string/reminders_empty_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
